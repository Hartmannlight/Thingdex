# PostgreSQL connection used by the API and Alembic.
DATABASE_URL=postgresql+psycopg://thingdex:change-me@127.0.0.1:5432/thingdex

# Name used when the single root location is created for the first time.
ROOT_LOCATION_NAME=World

# Optional label integration.
LABEL_PRINTING_ENABLED=false
PRINTHUB_API_BASE=http://printhub.example.test
# Legacy only when templates still come from a separate service:
# LABEL_API_BASE=http://label.example.test/api/v1
LABEL_CONTAINER_TEMPLATE_ID=container-name

# Optional base database used by the PostgreSQL-backed test suite.
# THINGDEX_TEST_DATABASE_URL=postgresql+psycopg://thingdex:change-me@127.0.0.1:5432/thingdex_test
